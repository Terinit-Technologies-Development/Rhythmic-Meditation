<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No INTERNET permission: Rhythmic Meditation is local-first and offline-capable.
        No overlay / accessibility / device-admin permissions: Rhythmic Routine owns
        all policy and device enforcement. Meditation owns meditation evidence only.
    -->

    <!--
        Signature-level permission guarding the status ContentProvider so that only
        same-signature companion apps (e.g. Rhythmic Routine) can read session status.
    -->
    <permission
        android:name="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS"
        android:protectionLevel="signature" />

    <!--
        Read-only cross-app evidence for Insights. Rhythmic Reader's Daily Evidence V2
        provider is guarded by this signature permission; nothing broader is requested
        and no book titles, contents, or annotations ever cross the boundary.
    -->
    <!-- Own signature permission: must be REQUESTED (not just declared) to
         hold it — required to read Routine's signature-protected projections
         (evening-signal, attention-insight). Found by device validation. -->
    <uses-permission android:name="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS" />
    <uses-permission android:name="com.terinit.rhythmicreader.permission.RECOVERY" />
    <!-- Active-session foreground service (spec 41): keeps the process alive
         during long screen-off meditation. Narrow scope: exists only while a
         qualifying session is ACTIVE. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Narrow package visibility for the two Routine launch variants and the
         read-only Routine/Reader content providers used by Insights. -->
    <queries>
        <package android:name="com.terinit.rhythmicroutine" />
        <package android:name="com.terinit.rhythmicroutine.qa" />
        <provider android:authorities="com.terinit.rhythmicroutine.attention-insight" />
        <provider android:authorities="com.terinit.rhythmicroutine.qa.attention-insight" />
        <provider android:authorities="com.terinit.rhythmicroutine.evening-signal" />
        <provider android:authorities="com.terinit.rhythmicroutine.qa.evening-signal" />
        <provider android:authorities="com.terinit.rhythmicreader.evidence" />
    </queries>

    <application
        android:name=".app.RhythmicMeditationApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RhythmicMeditation">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.RhythmicMeditation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Read-only, per-session IPC surface for Rhythmic Routine. Exported
             and guarded by both signature permission and caller verification. -->
        <provider
            android:name=".integration.provider.MeditationStatusProvider"
            android:authorities="com.terinit.rhythmicmeditation.status"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="com.terinit.rhythmicmeditation.permission.STATUS_ACCESS" />

        <!--
            Narrow active-session foreground service (evidence-mandated by the
            Pass 4 device matrix: Android killed the process ~17 min into a
            real screen-off session). Exists only while a session is ACTIVE.
        -->
        <service
            android:name=".runtime.ActiveSessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="meditation_session_timing" />
        </service>
    </application>

</manifest>
